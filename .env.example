# ─── Pipeline Configuration ───────────────────────────────────
# Copy this to .env.local for overrides. Never commit secrets to git.

# MySQL
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_USER=debezium
MYSQL_PASSWORD=debezium
MYSQL_DATABASE=shipments_db

# Kafka
KAFKA_BROKERS=kafka:29092
KAFKA_TOPIC=shipments.shipments_db.shipments
KAFKA_DLQ_TOPIC=shipments.dead-letter-queue

# MinIO (S3)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=password
S3_BUCKET=lakehouse

# Hudi
HUDI_TABLE_NAME=shipments_mor
HUDI_TABLE_PATH=s3a://lakehouse/data/shipments_mor
HUDI_CHECKPOINT_PATH=s3a://lakehouse/checkpoints/shipments_mor

# Hive Metastore
HIVE_METASTORE_URI=thrift://hive-metastore:9083

# Debezium
DEBEZIUM_CONNECTOR_NAME=shipments-connector

# Spark
SPARK_TRIGGER_INTERVAL=30 seconds
SPARK_MAX_OFFSETS_PER_TRIGGER=2000000
SPARK_CORES_MAX=8
SPARK_EXECUTOR_MEMORY=4g

# Observability
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_RETENTION=7d
